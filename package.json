{
  "name": "bpmn-middleware",
  "version": "0.21.2",
  "description": "BPMN engine express middleware",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/main.cjs",
      "types": "./types/index.d.ts"
    }
  },
  "scripts": {
    "test": "mocha",
    "posttest": "npm run lint && npm run dist && npm run test:md && npm run build:swagger --workspace=example",
    "lint": "eslint . --cache && npm run toc && prettier . --check --cache",
    "prepack": "npm run dist",
    "cov:html": "c8 -r html -r text mocha",
    "test:lcov": "c8 -r lcov mocha",
    "posttest:lcov": "npm run lint",
    "test:md": "texample ./README.md,./docs/API.md,./docs/multiple-extensions.md,./example/README.md",
    "dist": "dts-buddy && rollup -c",
    "toc": "toc README.md docs/API.md",
    "posttoc": "prettier --write README.md docs/API.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodep/bpmn-middleware.git"
  },
  "keywords": [
    "bpmn",
    "bpmn-engine",
    "express",
    "middleware",
    "call activity"
  ],
  "author": {
    "name": "Zerodep AB",
    "url": "https://github.com/zerodep"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zerodep/bpmn-middleware/issues"
  },
  "homepage": "https://0dep.se",
  "devDependencies": {
    "@0dep/toc": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@types/bpmn-moddle": "^10.0.0",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^7.2.0",
    "bpmn-moddle": "^10.2.0",
    "c8": "^12.0.0",
    "chai": "^6.0.1",
    "chronokinesis": "^8.0.0",
    "dts-buddy": "^0.8.3",
    "eslint": "^10.3.0",
    "express": "^5.1.0",
    "express-4": "npm:express@^4.21.2",
    "form-data": "^4.0.0",
    "globals": "^17.0.0",
    "mocha": "^11.0.1",
    "mocha-cakes-2": "^3.3.0",
    "nock": "^14.0.0",
    "prettier": "^3.3.3",
    "rollup": "^4.17.2",
    "supertest": "^7.0.0",
    "texample": "^1.0.2"
  },
  "dependencies": {
    "lru-cache": "^11.2.6",
    "multer": "^2.0.0"
  },
  "peerDependencies": {
    "@0dep/piso": ">=2",
    "bpmn-elements": ">=18.0.22",
    "bpmn-engine": ">=26",
    "debug": "4.x",
    "express": ">=4",
    "smqp": ">=13"
  },
  "overrides": {
    "mocha": {
      "yargs": "^18.0.0"
    }
  },
  "files": [
    "src/",
    "dist/",
    "types/index.d.ts*",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "example"
  ],
  "c8": {
    "include": [
      "src/",
      "example/"
    ]
  },
  "scarfSettings": {
    "enabled": false
  }
}
