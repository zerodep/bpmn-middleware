<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="dinnerProcessDefinitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="dinnerProcess" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>toDecideDish</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toDecideDish" sourceRef="start" targetRef="decideDish" />
    <bpmn:businessRuleTask id="decideDish" name="Decide dish" camunda:decisionRef="dinner-decisions/dish" camunda:resultVariable="dish">
      <bpmn:incoming>toDecideDish</bpmn:incoming>
      <bpmn:outgoing>toEnd</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="toEnd" sourceRef="decideDish" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>toEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dinnerProcessDiagram">
    <bpmndi:BPMNPlane id="dinnerProcessPlane" bpmnElement="dinnerProcess">
      <bpmndi:BPMNShape id="startShape" bpmnElement="start">
        <dc:Bounds x="179" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decideDishShape" bpmnElement="decideDish">
        <dc:Bounds x="269" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endShape" bpmnElement="end">
        <dc:Bounds x="432" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toDecideDishEdge" bpmnElement="toDecideDish">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="269" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toEndEdge" bpmnElement="toEnd">
        <di:waypoint x="369" y="117" />
        <di:waypoint x="432" y="117" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
