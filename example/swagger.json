    "/start/sync/{deploymentName}": {
      "post": {
        "description": "Run a deployment synchronously and respond with the engine's final output.\nSlot types mirror the start-deployment chain (`/start/sync/:deploymentName`)\nsince this handler is wired as the terminal of `middleware.start(runToEnd)`.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRunResult"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "deploymentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Deployment name"
            }
          },
          {
            "name": "autosaveEngineState",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Run until end"
            }
          },
          {
            "name": "idleTimeout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Idle timeout delay"
            }
          },
          {
            "name": "resumedBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Resumed by engine token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartDeploymentOptions"
              }
            }
          }
        }
      }
    },
