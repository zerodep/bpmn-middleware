  "components": {
    "schemas": {
      "SignalBody": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Activity id"
          },
          "executionId": {
            "type": "string",
            "description": "Activity execution id, required when signalling a parallel multi-instance tasks"
          }
        },
        "additionalProperties": true
      },
      "MiddlewareEngineState": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "engineVersion": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "idle",
                  "error",
                  "running",
                  "stopped"
                ]
              },
              "stopped": {
                "type": "boolean"
              },
              "environment": {
                "type": "object",
                "properties": {
                  "settings": {
                    "type": "object",
                    "properties": {
                      "enableDummyService": {
                        "type": "boolean",
                        "description": "true returns dummy service function for service task if not found"
                      },
                      "step": {
                        "type": "boolean",
                        "description": "true forces activity runs to go forward in steps, defaults to false"
                      },
                      "strict": {
                        "type": "boolean",
                        "description": "strict mode, see documentation, defaults to false"
                      },
                      "batchSize": {
                        "type": "number",
                        "description": "positive integer to control parallel loop batch size, defaults to 50"
                      },
                      "disableTrackState": {
                        "type": "boolean",
                        "description": "disable tracking state between recover and resume\ntrue will only return state for elements that are actually running\nDefaults to falsy"
                      }
                    },
                    "additionalProperties": true
                  },
                  "variables": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  },
                  "output": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false,
                "required": [
                  "settings",
                  "variables",
                  "output"
                ]
              },
              "definitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "required": [
                    "state"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "token": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Deployment name"
          },
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "error",
              "running",
              "stopped"
            ]
          },
          "activityStatus": {
            "$ref": "#/components/schemas/ActivityStatus"
          },
          "sequenceNumber": {
            "type": "number"
          },
          "postponed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/postponed"
            }
          },
          "caller": {
            "$ref": "#/components/schemas/Caller"
          },
          "expireAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Output from process"
          }
        },
        "additionalProperties": true,
        "required": [
          "token",
          "name"
        ]
      },
      "Caller": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Calling process token"
          },
          "deployment": {
            "type": "string",
            "description": "Calling process deployment name"
          },
          "id": {
            "type": "string",
            "description": "Calling activity id"
          },
          "type": {
            "type": "string",
            "description": "Calling activity type"
          },
          "executionId": {
            "type": "string",
            "description": "Calling activity execution id"
          }
        },
        "additionalProperties": false,
        "required": [
          "token",
          "deployment",
          "id",
          "type",
          "executionId"
        ]
      },
      "postponed": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ]
      },
      "ActivityStatus": {
        "type": "string",
        "enum": [
          "idle",
          "entered",
          "started",
          "executing",
          "executed",
          "end",
          "discard",
          "discarded",
          "error",
          "formatting",
          "timer",
          "wait"
        ]
      },
      "StartDeploymentOptions": {
        "type": "object",
        "properties": {
          "variables": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "businessKey": {
            "type": "string"
          },
          "caller": {
            "$ref": "#/components/schemas/Caller"
          },
          "idleTimeout": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "SyncRunResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Engine execution token"
          },
          "output": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Engine environment output"
          }
        },
        "additionalProperties": false,
        "required": [
          "token"
        ]
      },
      "PostponedElement": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
