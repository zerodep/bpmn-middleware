{
  "openapi": "3.0.0",
  "info": {
    "title": "BPMN 2.0 middleware example",
    "version": "0.0.0"
  },
  "paths": {
    "/rest/auth/process-definition/{deploymentName}/start": {
      "post": {
        "description": "Authorize the start of a deployment based on Camunda candidateStarterGroups.\nSlot types mirror the start-deployment chain (`/rest/auth/process-definition/:deploymentName/start`)\nsince express-swagger picks this handler as the operation's terminal annotation source.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartDeploymentResult"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "deploymentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Deployment name"
            }
          },
          {
            "name": "autosaveEngineState",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Run until end"
            }
          },
          {
            "name": "idleTimeout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Idle timeout delay"
            }
          },
          {
            "name": "resumedBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Resumed by engine token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartDeploymentOptions"
              }
            }
          }
        }
      }
    },
